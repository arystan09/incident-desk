# Synthetic portfolio environment. No database or model credentials needed.
INCIDENT_DESK_SERVICE_NAME=incident-desk
# Allowed: development, test, production. This label does not enable security.
INCIDENT_DESK_ENVIRONMENT=development

# Optional PostgreSQL development setup (never use production credentials).
POSTGRES_DB=incident_desk
POSTGRES_USER=incident_desk_dev
# Replace before starting the database. Keep the real value in ignored .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Set only when using persistence; percent-encode special password characters.
# INCIDENT_DESK_DATABASE_URL=postgresql+psycopg://incident_desk_dev:YOUR_PASSWORD@127.0.0.1:5432/incident_desk
INCIDENT_DESK_DATABASE_CONNECT_TIMEOUT=5
INCIDENT_DESK_DATABASE_STATEMENT_TIMEOUT_MS=10000
# TEST_DATABASE_URL must be exported in the shell, not read from .env by tests.
